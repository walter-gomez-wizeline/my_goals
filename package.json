{
  "name": "my-goals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs up",
    "db:migrate:status": "node --env-file=.env.local scripts/migration-status.mjs",
    "test:smoke": "playwright test",
    "db:migrate:plan": "node --env-file=.env.local scripts/migrate.mjs up --dry-run"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1"
  }
}
